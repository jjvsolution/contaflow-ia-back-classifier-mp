# Misma URL que el backend (Prisma). ?schema= se ignora: psycopg no lo acepta.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contaflow
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# En el host de Ollama (no en FastAPI). Alinear NUM_PARALLEL con LLM_CLASSIFY_CONCURRENCY del backend.
# OLLAMA_NUM_PARALLEL=5
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=-1
EMBEDDING_DIMENSIONS=768
# Debe coincidir con LLM_INTERNAL_TOKEN del backend (M01-017)
INTERNAL_TOKEN=cambia-este-token-compartido
RAG_COMPANY_LIMIT=8
RAG_GIRO_LIMIT=8
# Atajo: si hay ejemplo histórico muy parecido, clasifica sin llamar al chat LLM.
RAG_SHORT_CIRCUIT_ENABLED=true
RAG_SHORT_CIRCUIT_MAX_DIST=0.22
RAG_SHORT_CIRCUIT_MAX_DIST_SAME_CP=0.35
# INFO en prod (sin dumps de documento). DEBUG muestra preview de input_text.
LOG_LEVEL=INFO


# https://ollama.jjvs.cl/
# OLLAMA_HOST_QA=https://unemployed-caprice-jjvsolutions-7f31f51a.koyeb.app